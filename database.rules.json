/* =================================================================================================
   EM EVIDENCE SIM — FIREBASE REALTIME DATABASE SECURITY RULES
   Wave 4b. This file did not exist before; the database was running on console defaults.

   -------------------------------------------------------------------------------------------------
   WHAT YOU MUST DO IN THE FIREBASE CONSOLE (nobody can do these for you — they need your login)
   -------------------------------------------------------------------------------------------------
   1. ENABLE SIGN-IN
        Firebase console -> project "wmebem-sim" -> Build -> Authentication -> Get started
        -> Sign-in method -> Email/Password -> Enable -> Save.
        (Leave "Email link / passwordless" off. Google sign-in is optional; the app supports it
        only if you also add the Google provider — it degrades silently if you don't.)

   2. PASTE THESE RULES
        Build -> Realtime Database -> Rules tab. Select all, delete, paste this ENTIRE file
        (the console's rules editor accepts both comment styles, so leave the comments in place.
         NOTE: never write a literal comment-terminator inside this header — it would close the
         comment early and the whole file would fail to parse.)
        Press PUBLISH.

   3. MAKE YOURSELF AN ADMIN  (one manual write — by design)
        a. In the app, click "Sign in" -> "Create account" and sign up with your own email.
        b. Firebase console -> Authentication -> Users -> copy your User UID.
        c. Firebase console -> Realtime Database -> Data. Create these two values by hand:
               users/<YOUR_UID>/role    = "admin"      (string)
               users/<YOUR_UID>/status  = "approved"   (string)
        This step MUST be manual: rule 4 below forbids any user — including you — from writing
        their own role. That is the whole point. Once you are admin, the in-app "Admin" panel
        does every subsequent approval and entitlement grant for you.

   4. ADD RESTRICTED CONTENT WHEN YOU'RE READY
        Restricted (e.g. RCUK) scenarios live at  restrictedScenarios/<SCENARIO_ID>  and are read
        from the database AT RUNTIME. They are never in the shipped JavaScript. See README.md
        ("Restricted scenarios") for the exact JSON shape to paste.

   -------------------------------------------------------------------------------------------------
   DESIGN NOTES
   -------------------------------------------------------------------------------------------------
   * sessions/* stays OPEN to read and write without an account: a student monitor or defib
     tablet joins with nothing but a six-character session code. It is limited to current-format
     codes and to the fields the app writes (see section 1). It carries ephemeral simulation
     telemetry only.

   * users/$uid: a user may write only their own PROFILE fields (email, displayName, createdAt,
     lastSeenAt, requestedAccess), each granted separately; `role`, `status` and `entitlements`
     are ADMIN-WRITE-ONLY. (Write permission cascades down in Firebase rules, so granting a user
     .write on users/$uid itself would let them set entitlements.rcuk = true and help themselves
     to copyrighted content. tests/rules checks this in the emulator.)

   * Access is an ENTITLEMENTS MAP, not a boolean, so a paid tier is a new key rather than a
     rewrite:  entitlements: { rcuk: true, premium: false, expiresAt: null }

   * PAYMENT SEAM (NOT CONNECTED). When you sell licences, the payment provider's webhook must run
     SERVER-SIDE (Cloud Function / your own server) using the Firebase Admin SDK, which bypasses
     these rules entirely, and write users/$uid/entitlements itself. Entitlements must NEVER become
     client-writable — a client that can write its own entitlements has no paywall. The
     `paymentEvents` node below is closed to every client precisely so a server can own it.
   ================================================================================================= */
{
  "rules": {

    // ------------------------------------------------------------------------------------------
    // 1. SESSIONS — open to anyone with the code. The anonymous monitor/defib path depends on this.
    // ------------------------------------------------------------------------------------------
    "sessions": {
      // The clean-up job finds idle sessions by this (see README "Clearing out old sessions").
      ".indexOn": ["live/updatedAt"],
      "$code": {
        // Anyone with the code may read and write: a monitor or defib tablet joins with nothing but
        // the code and no account. Only current-format codes (six characters, no look-alikes such
        // as 0/O or 1/I/L) can be written, and only the fields the app writes: this limits what a
        // stranger could put in the database, though not how much data a known field holds.
        ".read": true,
        ".write": "$code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$/)",

        // The patient, published by the controller. Keep in step with the sync payload in
        // data/engine-sync.js: tests/specs/rules.spec.js fails if a key is missing here.
        "live": {
          "vitals": { ".validate": true },
          "rhythm": { ".validate": true },
          "cprInProgress": { ".validate": true },
          "etco2Enabled": { ".validate": true },
          "flash": { ".validate": true },
          "cycleTimer": { ".validate": true },
          "monitorTimer": { ".validate": true },
          "scenarioTitle": { ".validate": true },
          "patientName": { ".validate": true },
          "patientAge": { ".validate": true },
          "sex": { ".validate": true },
          "ageRange": { ".validate": true },
          "wetflag": { ".validate": true },
          "pathology": { ".validate": true },
          "investigations": { ".validate": true },
          "activeInterventions": { ".validate": true },
          "nibp": { ".validate": true },
          "speech": { ".validate": true },
          "soundEffect": { ".validate": true },
          "audioOutput": { ".validate": true },
          "trends": { ".validate": true },
          "arrestPanelOpen": { ".validate": true },
          "isFinished": { ".validate": true },
          "defibPanelOpen": { ".validate": true },
          "defib": { ".validate": true },
          "ventPanelOpen": { ".validate": "newData.isBoolean()" },
          "vent": {
            ".validate": "newData.hasChild('profile')",
            "profile": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "breathing": { ".validate": "newData.isBoolean()" },
            "airway": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "lung": { "$adj": { ".validate": "newData.isNumber()" } },
            "probs": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "assess": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "pacing": { ".validate": true },
          "defibView": { ".validate": true },
          "monitorPopup": { ".validate": true },
          "waveformGain": { ".validate": true },
          "noise": { ".validate": true },
          "notification": { ".validate": true },
          "remotePacerState": { ".validate": true },
          "pacingThreshold": { ".validate": true },
          "showWetflag": { ".validate": true },
          "co2Pathology": { ".validate": true },
          "co2Severity": { ".validate": true },
          "isRunning": { ".validate": true },
          "audioLive": { ".validate": true },
          "isMuted": { ".validate": true },
          "activeLoops": { ".validate": true },
          "isParalysed": { ".validate": true },
          "activeDrugs": { ".validate": true },
          "deteriorationMode": { ".validate": true },
          "potassium": { ".validate": true },
          "pocReadings": { ".validate": true },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        // Which screens are connected (heartbeat every 10 s, removed on disconnect).
        "presence": {
          "$client": {
            ".validate": "newData.hasChildren(['role', 'ts'])",
            "role": { ".validate": "newData.isString() && newData.val().length <= 20" },
            "display": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "ua": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        // Presses on a learner's defib and the ventilator's log lines, consumed by the controller.
        "deviceEvents": {
          "$event": {
            ".validate": "newData.hasChildren(['type', 'ts'])",
            "type": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "payload": { ".validate": true },
            "ts": { ".validate": "newData.isNumber()" },
            "from": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "device": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },
        // What each defib tablet is showing, mirrored on the controller.
        "deviceState": {
          "$client": {
            ".validate": "newData.hasChild('ts')",
            "mode": { ".validate": "newData.isString() && newData.val().length <= 12" }, "machine": { ".validate": "newData.isString() && newData.val().length <= 16" }, "energy": { ".validate": "newData.isNumber()" }, "sync": { ".validate": "newData.isBoolean()" },
            "lead": { ".validate": "newData.isString() && newData.val().length <= 8" }, "gain": { ".validate": "newData.isNumber()" }, "pacerOutput": { ".validate": "newData.isNumber()" }, "pacerRate": { ".validate": "newData.isNumber()" },
            "pacerDemand": { ".validate": "newData.isBoolean()" }, "message": { ".validate": "newData.isString() && newData.val().length <= 120" }, "messageType": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        // What each HAMILTON-T1 ventilator (vent/index.html) is showing, mirrored on the controller.
        "ventState": {
          "$client": {
            ".validate": "newData.hasChildren(['state', 'ts'])",
            "state": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "mode": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "label": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "ctl": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "lim": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "mon": { "$measure": { ".validate": "newData.isNumber()" } },
            "phys": { "$measure": { ".validate": "newData.isNumber()" } },
            "o2": { ".validate": "newData.isNumber()" },
            "alarms": { ".validate": "newData.isString() && newData.val().length <= 600" },
            "win": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "locked": { ".validate": "newData.isBoolean()" },
            "sex": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "height": { ".validate": "newData.isNumber()" },
            "ibw": { ".validate": "newData.isNumber()" },
            "tests": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "embedded": { ".validate": "newData.isBoolean()" },
            "sv": { ".validate": "newData.isString() && newData.val().length <= 1500" },
            "lv": { ".validate": "newData.isString() && newData.val().length <= 1500" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        // The facilitator's commands to one ventilator (power, start, standby, mode, a setting or an
        // alarm limit, silence, O2 enrichment, lock), consumed and removed by that ventilator.
        "ventCmd": {
          "$cmd": {
            ".validate": "newData.hasChildren(['type', 'to', 'ts'])",
            "type": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "to": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "key": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "val": { ".validate": "newData.isNumber()" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        // The room monitor's requests to the controller (NIBP, actions).
        "command": {
          ".validate": "newData.hasChildren(['type', 'ts'])",
          "type": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "payload": { ".validate": true },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    // ------------------------------------------------------------------------------------------
    // 2. USERS — profile self-service, privilege fields admin-only.
    // ------------------------------------------------------------------------------------------
    "users": {
      // An admin must be able to LIST users to approve them, so allow a collection read for
      // admins only. A normal user cannot read this level at all.
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        // Only an ADMIN may write the account as a whole. Write permission cascades DOWN and cannot
        // be taken back by a deeper rule, so a user must never be granted .write here: that would
        // let them write role/status/entitlements too (the previous version of this file did
        // exactly that; the emulator test in tests/rules caught it). A user gets .write only on the
        // profile fields below, one by one.
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",

        // ---- PRIVILEGE FIELDS: admin only (via the .write above). ----
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'user' || newData.val() === 'admin')"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected')"
        },
        "entitlements": {
          "$flag": {
            ".validate": "newData.isBoolean() || newData.isNumber() || newData.isString()"
          }
        },

        // ---- Self-service profile fields: the user themselves, or an admin. ----
        "email":       { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isString() && newData.val().length < 320" },
        "displayName": { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isString() && newData.val().length < 120" },
        "createdAt":   { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isNumber() || newData.isString()" },
        "lastSeenAt":  { ".write": "auth != null && auth.uid === $uid", ".validate": "newData.isNumber() || newData.isString()" },

        // Asking for access is not being granted access. This node is writable by the user and
        // carries no privilege whatsoever; the admin panel reads it to build the request queue.
        "requestedAccess": {
          ".write": "auth != null && auth.uid === $uid",
          "$flag": { ".validate": "newData.isBoolean() || newData.isString() || newData.isNumber()" }
        },

        "$other": { ".validate": false }
      }
    },

    // ------------------------------------------------------------------------------------------
    // 3. RESTRICTED SCENARIOS — copyrighted content, e.g. RCUK. Never in the JS bundle.
    //    Read requires: signed in + approved + entitlements.rcuk === true.
    //    Write requires: admin. (Client-side checks only control the UI; THIS is the enforcement.)
    // ------------------------------------------------------------------------------------------
    "restrictedScenarios": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('entitlements').child('rcuk').val() === true",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$scenarioId": {
        ".validate": "newData.hasChildren(['id', 'title'])"
      }
    },

    // ------------------------------------------------------------------------------------------
    // 4. PREMIUM SCENARIOS — reserved for the future paid tier. Identical pattern, different
    //    entitlement key, so paid content needs no new rule design.
    // ------------------------------------------------------------------------------------------
    "premiumScenarios": {
      ".read":  "auth != null && root.child('users').child(auth.uid).child('status').val() === 'approved' && root.child('users').child(auth.uid).child('entitlements').child('premium').val() === true",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    // ------------------------------------------------------------------------------------------
    // 5. PAYMENT SEAM — closed to every client, in both directions. A trusted server using the
    //    Admin SDK bypasses rules and is the only thing that may ever touch this node, or
    //    users/$uid/entitlements. DO NOT RELAX THIS.
    // ------------------------------------------------------------------------------------------
    "paymentEvents": {
      ".read": false,
      ".write": false
    }

    // Anything not listed above is denied: as soon as any rule exists, Firebase's default for
    // unmatched paths is deny. No catch-all wildcard is used here on purpose, because a wildcard
    // sibling of named keys is easy to mis-read as granting access.
  }
}
